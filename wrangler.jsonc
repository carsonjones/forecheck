{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forecheck",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-22",
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "04f33cbb56bc44b099a0b444359c70b4"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forecheck",
      "database_id": "2083472b-de3b-496d-84ca-66cceceff66f",
      "preview_database_id": "2083472b-de3b-496d-84ca-66cceceff66f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HIGHLIGHTS",
      "bucket_name": "forecheck"
    }
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "forecheck-transcripts"
    }
  ],
  "triggers": {
    "crons": [
      "0 6 * * *"
    ]
  },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin/*"
    ]
  }
}
