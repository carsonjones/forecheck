{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forecheck",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forecheck",
      "database_id": "2083472b-de3b-496d-84ca-66cceceff66f",
      "preview_database_id": "REPLACE_WITH_D1_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_ID",
      "preview_id": "REPLACE_WITH_KV_ID"
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}

